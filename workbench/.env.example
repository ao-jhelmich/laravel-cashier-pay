APP_NAME=LaravelCashierWorkbench
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Merchant credentials (preferred for Order:Create)
PAYNL_API_TOKEN_CODE=AT-xxxx-xxxx
PAYNL_TOKEN=

# Sales location (required on the order; also used for Basic auth if AT-code is omitted)
PAYNL_SERVICE_ID=SL-xxxx-xxxx
